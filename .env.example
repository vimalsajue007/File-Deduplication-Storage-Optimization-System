# ---------------------------------------------------------------------------
# Copy to .env and edit.   cp .env.example .env
# Used by docker-compose (variable substitution + container environment).
# ---------------------------------------------------------------------------

# --- General ----------------------------------------------------------------
APP_NAME=Intelligent File Deduplication
ENVIRONMENT=development            # set to "production" to enforce a strong JWT secret
LOG_LEVEL=INFO
LOG_DIR=/app/logs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_REGISTRATION=true
TRUST_PROXY_HEADERS=true           # true behind the bundled nginx so audit logs record real client IPs

# --- Ports exposed on your machine -------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- MySQL 8.0 ---------------------------------------------------------------
# Inside docker-compose the host is the service name "mysql".
# For local (non-Docker) development use MYSQL_HOST=127.0.0.1
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=dedupe_db
MYSQL_USER=dedupe
MYSQL_PASSWORD=change_this_db_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# --- Redis / Celery ----------------------------------------------------------
# Local development: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false     # true = hash inline without a worker (handy for quick local runs)

# --- Authentication ----------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- File handling -----------------------------------------------------------
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=1024            # per file
MAX_FILES_PER_UPLOAD=20
HASH_CHUNK_SIZE_KB=4096            # memory used while hashing = one chunk
COPY_CHUNK_SIZE_KB=1024
BLOCKED_EXTENSIONS=exe,dll,bat,cmd,com,msi,scr,pif,cpl,vbs,vbe,wsf,jar,apk,app,ps1,reg,lnk,hta
